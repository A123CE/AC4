{
  "name": "ac4-palace-visualization",
  "version": "2.0.0",
  "description": "故宫可视化系统 - 前后端全栈应用",
  "scripts": {
    "server": "cd server && npm start",
    "client": "cd client && npm run dev",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "build": "cd client && npm run build",
    "db:init": "mysql -u root -p < server/db/init_full.sql",
    "db:migrate": "node scripts/migrate.mjs",
    "db:test:init": "node scripts/db-test-init.mjs",
    "test": "npm run test:client && npm run test:server",
    "test:client": "cd client && npm run test",
    "test:server": "cd server && npm run test",
    "test:e2e": "playwright test --config=test/e2e/playwright.config.js",
    "test:all": "npm run test && npm run test:contract && npm run test:e2e",
    "test:contract": "node --test --test-force-exit server/test/contract.test.js",
    "snapshot:api": "node scripts/snapshot-api.mjs",
    "audit:assets": "node scripts/audit-assets.mjs",
    "schema:diff": "node scripts/schema-diff.mjs",
    "ci:gate": "npm run lint && npm run test && npm run test:contract && npm run schema:diff && npm run test:e2e",
    "lint": "cd client && npm run lint",
    "seo:check": "node scripts/seo-check.mjs",
    "ugc:check": "node scripts/check-ugc-blocked.mjs",
    "bg:hash": "node scripts/bg-content-hash.mjs",
    "bg:measure": "node scripts/measure-bg-layout.mjs",
    "bg:events": "node scripts/check-bg-events.mjs",
    "bk:events": "node scripts/check-bk-events.mjs",
    "enc3d:events": "node scripts/check-card-events.mjs",
    "enc3d:measure": "node scripts/measure-enc-3d.mjs"
  },
  "keywords": [
    "visualization",
    "forbidden-city",
    "threejs",
    "react"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "playwright": "^1.61.1"
  },
  "dependencies": {
    "liquid-glass-react": "^1.1.1"
  }
}
